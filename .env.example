# Default LLM provider. Used by the chat agent AND by the audit's qualitative
# pass (single generateObject call). Required.
OPENAI_API_KEY=

# Optional: override the OpenAI model. Default is gpt-4o-mini.
# Vision is engaged automatically on gpt-4o* / gpt-4.1* / o-series / gpt-5*
# models — the icon and first 3 screenshots are sent as image inputs to the
# qualitative pass. Other model IDs gracefully downgrade to text-only.
# ASO_AUDIT_MODEL=

# Optional: NVIDIA NIM (free tier, OpenAI-compatible). Only used if
# OPENAI_API_KEY is unset. Get a key at https://build.nvidia.com.
# Default NIM model is meta/llama-3.3-70b-instruct. NIM is treated as
# text-only — for vision-based icon/screenshot judgement use an OpenAI key.
# NVIDIA_API_KEY=

# --- Deployment (Vercel) -----------------------------------------------------
# Only needed when deploying to a serverless host. Locally these are optional
# and the app will use a SQLite file (./mastra.db) for Mastra storage.
#
# Turso is a hosted libsql provider with a generous free tier. Create a DB at
# https://turso.tech and copy the URL + auth token here.
# TURSO_DATABASE_URL=libsql://your-db-yourorg.turso.io
# TURSO_AUTH_TOKEN=

# Set to 1 to skip the DuckDB observability domain (it has native bindings that
# don't bundle on Vercel). Auto-disabled when the VERCEL env var is present.
# DISABLE_OBSERVABILITY_STORE=
